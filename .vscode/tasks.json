{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lazbuild: build",
      "type": "shell",
      "command": "lazbuild",
      "args": ["./apps/pasc/pasc.lpi"],
      "problemMatcher": {
        "owner": "external",
        "fileLocation": ["absolute"],
        "pattern": {
           "regexp": "(([A-Za-z]):\\\\(?:[^\\/:*?\"<>|\\r\\n]+\\\\)*[^\\/\\s\\(:*?\"<>|\\r\\n]*)\\((\\d+),(\\d+)\\)\\s.*(Fatal|Error|Warning|Hint|Note):\\s\\((\\d+)\\)\\s(.*)$",
           "file": 1,
           "line": 3,
           "column": 4,
           "severity": 5,
           "code": 6,
           "message": 7
        },
        "severity": "info"
      },      
      "dependsOn": "build resources",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build resources",
      "type": "shell",
      "windows": {"command": "./resources/compile.ps1", "options": {"cwd": "${workspaceFolder}/apps/pasc"}},
      "linux": {"command": "./resources/compile.sh", "options": {"cwd": "${workspaceFolder}/apps/pasc"}},
      "osx": {"command": "./resources/compile.sh", "options": {"cwd": "${workspaceFolder}/apps/pasc"}},
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "build tests resources",
      "type": "shell",
      "windows": {"command": "./tests/resources/compile.ps1", "options": {"cwd": "${workspaceFolder}/apps/pasc"}},
      "linux": {"command": "./tests/resources/compile.sh", "options": {"cwd": "${workspaceFolder}/apps/pasc"}},
      "osx": {"command": "./tests/resources/compile.sh", "options": {"cwd": "${workspaceFolder}/apps/pasc"}},
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "pasc: tests build",
      "type": "shell",
      "command": "lazbuild",
      "args": ["./apps/pasc/tests/TestPasc.lpi"],
      "dependsOn": "build tests resources"
    },
    {
      "label": "pasc: tests",
      "type": "shell",
      "command": "./apps/pasc/pasc",
      "args": ["test"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "pasc: tests build"
    },
    {
      "label": "pasc: watch, build and tests",
      "type": "shell",
      "command": "pasc",
      "args": ["watch", "--build", "--test", "."],
      "options": {"cwd": "${workspaceFolder}/apps/pasc"},
      "problemMatcher": []
    },
    {
      "label": "pasc: watch, build and tests=specificsuite",
      "type": "shell",
      "command": "pasc",
      "args": ["watch", "--build", "--test=TTestCommandInstall", "."],
      "options": {"cwd": "${workspaceFolder}/apps/pasc"},
      "problemMatcher": []
    },
    {
      "label": "pasdoc: build documentation",
      "type": "shell",
      "command": "./apps/pasc/pasc",
      "args": ["docs"],
      "problemMatcher": []
    }
  ]
}