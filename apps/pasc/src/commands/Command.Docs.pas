/// <summary> This unit contains procedures to configure and execute a command to generate the
/// project documentation with pasdoc, from the pages in docs/generate and the project sources.
/// It replaces the docs/generate/build.ps1 script that pasc add --docs used to create.
/// </summary>
unit Command.Docs;

{$MODE DELPHI}{$H+}

interface

uses
  Command.Interfaces;

const
  /// <summary> Folder of the documentation pages, relative to the project root. </summary>
  DOCS_SOURCE_DIR = 'docs/generate';

  /// <summary> Folder of the generated documentation, relative to the project root. </summary>
  DOCS_OUTPUT_DIR = 'docs';

  /// <summary> Generates the documentation with pasdoc, by convention:
  /// - docs/generate/introduction.txt is the introduction, and conclusion.txt the conclusion;
  /// - every other docs/generate/*.txt is an additional page; the command*.txt pages are grouped
  ///   as Commands in the menu, after the other pages;
  /// - the sources are the units in the search paths of the project (.lpi or .lpk) in the
  ///   current folder, and its main program; at the root of a workspace, of every member;
  /// - docs/generate/custom.css, when it exists, replaces the pasdoc stylesheet.
  /// The output goes to docs. The exit code is 1 when pasdoc is missing or fails. </summary>
  /// <param name="ABuilder"> Command builder of the main application that will be used to
  /// output info about the generation. </param>
  procedure DocsCommand(ABuilder: ICommandBuilder);

  /// <summary> Registry a docs command using the command builder from pascli. </summary>
  /// <param name="ABuilder"> Command builder of the main application that will be used to
  /// registry the command. </param>
  procedure Registry(ABuilder: ICommandBuilder);

  {$IF DEFINED(TESTAPP)}

  /// <summary> Returns the source files to document from the given project root: the .pas and
  /// .pp files in the search paths of its project file, and its main program. At the root of a
  /// workspace, the sources of every member. Paths into the boss modules folder are not
  /// documented. </summary>
  /// <param name="ARootDir"> Project or workspace root folder. </param>
  function GetDocsSources(const ARootDir: string): TArray<string>;

  /// <summary> Returns the additional pages of a docs/generate folder in the order of the menu:
  /// the guides first, then the command*.txt pages, each group sorted by name. The introduction
  /// and conclusion are not included. </summary>
  /// <param name="ADocsDir"> docs/generate folder. </param>
  function GetDocsPages(const ADocsDir: string): TArray<string>;

  /// <summary> Reorganizes the navigation menu of a page generated by pasdoc: the guides first,
  /// then the command pages under Commands, then the reference pages under Reference.
  /// Returns the page unchanged if it has no menu. </summary>
  /// <param name="AHtml"> Page content. </param>
  function OrganizeNavigation(const AHtml: string): string;

  {$ENDIF}

implementation

uses
  Classes,
  SysUtils,
  StrUtils,
  Command.Build,
  Utils.IO,
  Utils.Output,
  Utils.Shell,
  Utils.Workspace;

function SortedFiles(const ADir, AMask: string): TArray<string>;
var
  LSearch: TSearchRec;
  LList: TStringList;
  LName: string;
begin
  Result := [];
  LList := TStringList.Create;
  try
    if FindFirst(ConcatPaths([ADir, AMask]), faAnyFile, LSearch) = 0 then
      try
        repeat
          if (LSearch.Attr and faDirectory) = 0 then
            LList.Add(ConcatPaths([ADir, LSearch.Name]));
        until FindNext(LSearch) <> 0;
      finally
        FindClose(LSearch);
      end;
    LList.Sort;
    for LName in LList do
      Result := Result + [LName];
  finally
    LList.Free;
  end;
end;

procedure AddUnique(var AList: TArray<string>; const AValue: string);
var
  LItem: string;
begin
  for LItem in AList do
    if SameFileName(LItem, AValue) then
      Exit;
  AList := AList + [AValue];
end;

function GetProjectSources(const AProjectFile: string): TArray<string>;
const
  TAG = '<OtherUnitFiles Value="';
var
  LContent, LDir, LEntry, LPath, LFile: string;
  LStart, LEnd, LOffset: Integer;
begin
  Result := [];
  LDir := ExtractFileDir(ExpandFileName(AProjectFile));
  LContent := GetFileContent(AProjectFile);
  LOffset := 1;
  repeat
    LStart := PosEx(TAG, LContent, LOffset);
    if LStart = 0 then
      Break;
    Inc(LStart, Length(TAG));
    LEnd := PosEx('"', LContent, LStart);
    if LEnd = 0 then
      Break;
    for LEntry in SplitString(Copy(LContent, LStart, LEnd - LStart), ';') do
    begin
      // macros are not resolved, and the boss modules are dependencies, not the project
      if (Trim(LEntry) = '') or ContainsStr(LEntry, '$(') then
        Continue;
      LPath := SetDirSeparators(Trim(LEntry));
      if AnsiMatchText('modules', SplitString(StringReplace(LPath, PathDelim, '/', [rfReplaceAll]), '/')) then
        Continue;
      if not ((LPath <> '') and (LPath[1] = PathDelim)) then
        LPath := ConcatPaths([LDir, LPath]);
      LPath := ExpandFileName(LPath);
      for LFile in SortedFiles(LPath, '*.pas') + SortedFiles(LPath, '*.pp') do
        AddUnique(Result, LFile);
    end;
    LOffset := LEnd + 1;
  until False;

  // the main program of an app
  LFile := ChangeFileExt(ExpandFileName(AProjectFile), '.lpr');
  if FileExists(LFile) then
    AddUnique(Result, LFile);
end;

function GetDocsSources(const ARootDir: string): TArray<string>;
var
  LProjectFile, LFile: string;
  LMember: TWorkspaceMember;
begin
  Result := [];
  LProjectFile := FindProject(ARootDir, '');
  if (LProjectFile = '') and FileExists(ConcatPaths([ARootDir, WORKSPACE_FILE])) then
  begin
    for LMember in SortMembersByDependency(GetWorkspaceMembers(ARootDir)) do
      for LFile in GetProjectSources(LMember.ProjectFile) do
        AddUnique(Result, LFile);
    Exit;
  end;

  if SameText(ExtractFileExt(LProjectFile), '.lpr') then
    LProjectFile := ChangeFileExt(LProjectFile, '.lpi');
  if FileExists(LProjectFile) then
    Result := GetProjectSources(LProjectFile);
end;

function IsSpecialPage(const AFileName: string): Boolean;
begin
  Result := AnsiMatchText(ChangeFileExt(ExtractFileName(AFileName), ''), ['introduction', 'conclusion']);
end;

function GetDocsPages(const ADocsDir: string): TArray<string>;
var
  LFile: string;
  LCommands: TArray<string>;
begin
  Result := [];
  LCommands := [];
  for LFile in SortedFiles(ADocsDir, '*.txt') do
  begin
    if IsSpecialPage(LFile) then
      Continue;
    if StartsText('command', ExtractFileName(LFile)) then
      LCommands := LCommands + [LFile]
    else
      Result := Result + [LFile];
  end;
  Result := Result + LCommands;
end;

function MenuGroup(const AItem: string): Integer;
var
  LStart, LEnd: Integer;
  LHref: string;
begin
  // 0: guides, 1: commands, 2: reference, 3: anything else (like the search box)
  Result := 3;
  LStart := Pos('href="', AItem);
  if LStart = 0 then
    Exit;
  Inc(LStart, Length('href="'));
  LEnd := PosEx('"', AItem, LStart);
  LHref := Copy(AItem, LStart, LEnd - LStart);
  if StartsText('All', LHref) or SameText(LHref, 'ClassHierarchy.html') then
    Result := 2
  else if StartsText('command', LHref) then
    Result := 1
  else
    Result := 0;
end;

function OrganizeNavigation(const AHtml: string): string;
const
  MENU = '<ul class="nav flex-column';
  ITEM = '<li class="nav-item';
  HEADER = '<li class="nav-item pt-3"><span class="nav-link px-2 py-1 fw-bold">%s</span></li>';
  // the headers added by a previous run, rebuilt instead of kept
  HEADER_MARK = '<span class="nav-link px-2 py-1 fw-bold">';
var
  LStart, LMenuEnd, LListStart, LItemStart, LItemEnd, I: Integer;
  LItems, LGroups: array[0..3] of string;
  LItem, LMenu: string;
begin
  Result := AHtml;
  LStart := Pos(MENU, AHtml);
  if LStart = 0 then
    Exit;
  LListStart := PosEx('>', AHtml, LStart) + 1;
  LMenuEnd := PosEx('</ul>', AHtml, LListStart);
  if LMenuEnd = 0 then
    Exit;

  for I := 0 to 3 do
    LItems[I] := '';
  LItemStart := PosEx(ITEM, AHtml, LListStart);
  while (LItemStart > 0) and (LItemStart < LMenuEnd) do
  begin
    LItemEnd := PosEx('</li>', AHtml, LItemStart) + Length('</li>');
    LItem := Copy(AHtml, LItemStart, LItemEnd - LItemStart);
    if Pos(HEADER_MARK, LItem) = 0 then
    begin
      I := MenuGroup(LItem);
      LItems[I] := LItems[I] + LItem;
    end;
    LItemStart := PosEx(ITEM, AHtml, LItemEnd);
  end;

  LGroups[0] := '';
  LGroups[1] := 'Commands';
  LGroups[2] := 'Reference';
  LGroups[3] := '';
  LMenu := '';
  for I := 0 to 3 do
    if LItems[I] <> '' then
    begin
      if LGroups[I] <> '' then
        LMenu := LMenu + Format(HEADER, [LGroups[I]]);
      LMenu := LMenu + LItems[I];
    end;

  Result := Copy(AHtml, 1, LListStart - 1) + LMenu + Copy(AHtml, LMenuEnd, MaxInt);
end;

procedure DocsCommand(ABuilder: ICommandBuilder);
var
  LRootDir, LDocsDir, LOutputDir, LOutput, LPage, LLine: string;
  LArgs, LSources: TArray<string>;
  LExitCode: Integer = 0;
  LCount: Integer = 0;
  LFile: string;
begin
  LRootDir := ExcludeTrailingPathDelimiter(GetCurrentDir);
  LDocsDir := ConcatPaths([LRootDir, SetDirSeparators(DOCS_SOURCE_DIR)]);
  LOutputDir := ConcatPaths([LRootDir, DOCS_OUTPUT_DIR]);
  if not DirectoryExists(LDocsDir) then
  begin
    OutputError(ABuilder, 'Error', DOCS_SOURCE_DIR + ' not found, run pasc add --docs to create it.');
    ExitCode := 1;
    Exit;
  end;

  LSources := GetDocsSources(LRootDir);
  if Length(LSources) = 0 then
  begin
    OutputError(ABuilder, 'Error', 'No project or source files found to document in ' + LRootDir + '.');
    ExitCode := 1;
    Exit;
  end;

  LArgs := ['--format=html', '--use-tipue-search', '--output=' + LOutputDir];
  if FileExists(ConcatPaths([LDocsDir, 'custom.css'])) then
    LArgs := LArgs + ['--css=' + ConcatPaths([LDocsDir, 'custom.css'])];
  if FileExists(ConcatPaths([LDocsDir, 'introduction.txt'])) then
    LArgs := LArgs + ['--introduction=' + ConcatPaths([LDocsDir, 'introduction.txt'])];
  if FileExists(ConcatPaths([LDocsDir, 'conclusion.txt'])) then
    LArgs := LArgs + ['--conclusion=' + ConcatPaths([LDocsDir, 'conclusion.txt'])];
  for LPage in GetDocsPages(LDocsDir) do
    LArgs := LArgs + ['--additional=' + LPage];
  LArgs := LArgs + LSources;

  OutputInfo(ABuilder, 'Docs', Format('generating with pasdoc: %d pages, %d sources',
    [Length(GetDocsPages(LDocsDir)), Length(LSources)]));
  try
    LOutput := ShellExecute('pasdoc', LArgs, LExitCode);
  except
    on E: Exception do
    begin
      OutputError(ABuilder, 'Error', 'pasdoc was not found. Install it, for example with ' +
        'mise use -g github:pasdoc/pasdoc, or from https://pasdoc.github.io');
      ExitCode := 1;
      Exit;
    end;
  end;

  if LExitCode <> 0 then
  begin
    ABuilder.Output(LOutput);
    OutputError(ABuilder, 'Error', 'pasdoc failed with exit code ' + IntToStr(LExitCode));
    ExitCode := LExitCode;
    Exit;
  end;

  for LLine in SplitString(LOutput, LineEnding) do
    if StartsText('Warning', Trim(LLine)) then
      OutputError(ABuilder, 'Warning', Trim(LLine));

  for LFile in SortedFiles(LOutputDir, '*.html') do
  begin
    SaveFileContent(LFile, OrganizeNavigation(GetFileContent(LFile)));
    Inc(LCount);
  end;
  OutputInfo(ABuilder, 'Docs', Format('%d pages generated in %s', [LCount, LOutputDir]));
end;

procedure Registry(ABuilder: ICommandBuilder);
begin
  ABuilder
    .AddCommand(
      'docs',
      'generates the project documentation with pasdoc into the docs folder.'#13#10 +
      'docs/generate/introduction.txt is the introduction and every other .txt in it '#13#10 +
      'an additional page; command*.txt pages are grouped as Commands in the menu. '#13#10 +
      'The sources are the units in the search paths of the project, or of every member '#13#10 +
      'at the root of a workspace. docs/generate/custom.css, if any, replaces the style.'#13#10 +
      'Ex: ' + ABuilder.ExeName + ' docs',
      @DocsCommand,
      [ccNoParameters]);
end;

end.
