LazarusResources.Add('webtestfakerepository','TXT',[
  '/// <summary> A customers repository in memory, so the service tests run wit'
  +'hout a database.'#10'/// It overrides the methods of the repository contrac'
  +'t, like any other implementation.'#10'/// </summary>'#10'unit FakeCustomerR'
  +'epository;'#10#10'{$MODE DELPHI}{$H+}'#10#10'interface'#10#10'uses'#10'  Re'
  +'po.Models,'#10'  Repo.Customers;'#10#10'type'#10#10'  TFakeCustomerReposito'
  +'ry = class(TCustomerRepository)'#10'  private'#10'    FCustomers: TCustomer'
  +'s;'#10'  public'#10'    function All: TCustomers; override;'#10'    functio'
  +'n Find(const AId: Integer; out ACustomer: TCustomer): Boolean; override;'#10
  +'    function FindByEmail(const AEmail: string; out ACustomer: TCustomer): B'
  +'oolean; override;'#10'    function Insert(const ACustomer: TCustomer): TCus'
  +'tomer; override;'#10'  end;'#10#10'implementation'#10#10'uses'#10'  SysUtil'
  +'s;'#10#10'function TFakeCustomerRepository.All: TCustomers;'#10'begin'#10' '
  +' Result := Copy(FCustomers);'#10'end;'#10#10'function TFakeCustomerReposito'
  +'ry.Find(const AId: Integer; out ACustomer: TCustomer): Boolean;'#10'var'#10
  +'  LCustomer: TCustomer;'#10'begin'#10'  ACustomer := Default(TCustomer);'#10
  +'  for LCustomer in FCustomers do'#10'    if LCustomer.Id = AId then'#10'   '
  +' begin'#10'      ACustomer := LCustomer;'#10'      Exit(True);'#10'    end;'
  +#10'  Result := False;'#10'end;'#10#10'function TFakeCustomerRepository.Find'
  +'ByEmail(const AEmail: string; out ACustomer: TCustomer): Boolean;'#10'var'
  +#10'  LCustomer: TCustomer;'#10'begin'#10'  ACustomer := Default(TCustomer);'
  +#10'  for LCustomer in FCustomers do'#10'    if SameText(LCustomer.Email, AE'
  +'mail) then'#10'    begin'#10'      ACustomer := LCustomer;'#10'      Exit(T'
  +'rue);'#10'    end;'#10'  Result := False;'#10'end;'#10#10'function TFakeCus'
  +'tomerRepository.Insert(const ACustomer: TCustomer): TCustomer;'#10'begin'#10
  +'  Result := ACustomer;'#10'  Result.Id := Length(FCustomers) + 1;'#10'  FCu'
  +'stomers := FCustomers + [Result];'#10'end;'#10#10'end.'#10
]);
