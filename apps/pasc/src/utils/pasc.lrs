  +':= ''Ana'';'#10'  LCustomer.Email := ''ana@example.com'';'#10'  AssertEqual'
  +'s(''[{ "id" : 1, "name" : "Ana", "email" : "ana@example.com" }]'', Customer'
  +'sToJSON([LCustomer]));'#10'end;'#10#10'initialization'#10'  RegisterTest(TT'
  +'estCustomersPayloads);'#10#10'end.'#10
]);
