  +#10
]);
LazarusResources.Add('webcustomerspayloads','TXT',[
  '/// <summary> The payloads of the customers routes: what a request sends (in'
  +'put) and what a'#10'/// response returns (output), with their JSON conversi'
  +'on. </summary>'#10'unit Customers.Payloads;'#10#10'{$MODE DELPHI}{$H+}'#10
  +#10'interface'#10#10'uses'#10'  SysUtils,'#10'  fpjson,'#10'  Repo.Models;'
  +#10#10'type'#10#10'  /// <summary> The body of POST /customers. </summary>'
  +#10'  TCustomerInput = record'#10'    Name: string;'#10'    Email: string;'
  +#10'    /// <summary> Reads the input from a JSON body. Raises EPayloadError'
  +' if it is not a JSON'#10'    /// object. </summary>'#10'    class function '
  +'FromJSON(const ABody: string): TCustomerInput; static;'#10'  end;'#10#10'  '
  +'/// <summary> A customer returned by the routes. </summary>'#10'  TCustomer'
  +'Output = record'#10'    Id: Integer;'#10'    Name: string;'#10'    Email: s'
  +'tring;'#10'    class function FromModel(const ACustomer: TCustomer): TCusto'
  +'merOutput; static;'#10'    function ToJSON: TJSONObject;'#10'  end;'#10#10
  +'  TCustomerOutputs = TArray<TCustomerOutput>;'#10#10'  /// <summary> A body'
  +' that can not be read. </summary>'#10'  EPayloadError = class(Exception);'
  +#10#10'  /// <summary> Returns the outputs as a JSON array. </summary>'#10' '
  +' function CustomersToJSON(const ACustomers: TCustomerOutputs): string;'#10
  +#10'implementation'#10#10'uses'#10'  jsonparser;'#10#10'class function TCust'
  +'omerInput.FromJSON(const ABody: string): TCustomerInput;'#10'var'#10'  LDat'
  +'a: TJSONData = nil;'#10'begin'#10'  try'#10'    LData := GetJSON(ABody);'#10
  +'  except'#10'    on E: Exception do'#10'      raise EPayloadError.Create('''
  +'the body is not a valid JSON: '' + E.Message);'#10'  end;'#10#10'  try'#10
  +'    if not (LData is TJSONObject) then'#10'      raise EPayloadError.Create'
  +'(''the body must be a JSON object'');'#10'    Result.Name := TJSONObject(LD'
  +'ata).Get(''name'', '''');'#10'    Result.Email := TJSONObject(LData).Get('''
  +'email'', '''');'#10'  finally'#10'    LData.Free;'#10'  end;'#10'end;'#10#10
  +'class function TCustomerOutput.FromModel(const ACustomer: TCustomer): TCust'
  +'omerOutput;'#10'begin'#10'  Result.Id := ACustomer.Id;'#10'  Result.Name :='
  +' ACustomer.Name;'#10'  Result.Email := ACustomer.Email;'#10'end;'#10#10'fun'
  +'ction TCustomerOutput.ToJSON: TJSONObject;'#10'begin'#10'  Result := TJSONO'
  +'bject.Create([''id'', Id, ''name'', Name, ''email'', Email]);'#10'end;'#10
  +#10'function CustomersToJSON(const ACustomers: TCustomerOutputs): string;'#10
  +'var'#10'  LArray: TJSONArray;'#10'  LCustomer: TCustomerOutput;'#10'begin'
  +#10'  LArray := TJSONArray.Create;'#10'  try'#10'    for LCustomer in ACusto'
  +'mers do'#10'      LArray.Add(LCustomer.ToJSON);'#10'    Result := LArray.As'
  +'JSON;'#10'  finally'#10'    LArray.Free;'#10'  end;'#10'end;'#10#10'end.'#10
]);
LazarusResources.Add('webcustomersroutes','TXT',[
  '/// <summary> The routes of the customers feature. Each handler resolves the'
  +' service from the'#10'/// request, registered by the Build unit, and turns '
  +'the business errors into HTTP status codes.'#10'/// </summary>'#10'unit Cus'
  +'tomers.Routes;'#10#10'{$MODE DELPHI}{$H+}'#10#10'interface'#10#10'  /// <su'
  +'mmary> Registers the customers routes in horse. </summary>'#10'  procedure '
  +'Registry;'#10#10'implementation'#10#10'uses'#10'  SysUtils,'#10'  fpjson,'
  +#10'  Horse,'#10'  Horse.Commons,'#10'  Customers.Payloads,'#10'  Customers.'
  +'Service;'#10#10'function Service(AReq: THorseRequest): TCustomerService;'#10
  +'begin'#10'  // created by the factory of the Build unit and freed with the '
  +'request'#10'  Result := TCustomerService(AReq.Services.Resolve(TCustomerSer'
  +'vice));'#10'end;'#10#10'procedure SendJSON(ARes: THorseResponse; const AJSO'
  +'N: string; const AStatus: THTTPStatus = THTTPStatus.OK);'#10'begin'#10'  AR'
  +'es.ContentType(''application/json'').Send(AJSON).Status(AStatus);'#10'end;'
  +#10#10'procedure SendError(ARes: THorseResponse; const AMessage: string; con'
  +'st AStatus: THTTPStatus);'#10'var'#10'  LError: TJSONObject;'#10'begin'#10
  +'  LError := TJSONObject.Create([''error'', AMessage]);'#10'  try'#10'    Se'
  +'ndJSON(ARes, LError.AsJSON, AStatus);'#10'  finally'#10'    LError.Free;'#10
  +'  end;'#10'end;'#10#10'procedure SendCustomer(ARes: THorseResponse; const A'
  +'Customer: TCustomerOutput; const AStatus: THTTPStatus);'#10'var'#10'  LJSON'
  +': TJSONObject;'#10'begin'#10'  LJSON := ACustomer.ToJSON;'#10'  try'#10'   '
  +' SendJSON(ARes, LJSON.AsJSON, AStatus);'#10'  finally'#10'    LJSON.Free;'
  +#10'  end;'#10'end;'#10#10'procedure ListCustomers(AReq: THorseRequest; ARes'
  +': THorseResponse; ANext: TNextProc);'#10'begin'#10'  SendJSON(ARes, Custome'
  +'rsToJSON(Service(AReq).List));'#10'end;'#10#10'procedure GetCustomer(AReq: '
  +'THorseRequest; ARes: THorseResponse; ANext: TNextProc);'#10'var'#10'  LId: '
  +'Integer;'#10'begin'#10'  if not TryStrToInt(AReq.Params[''id''], LId) then'
  +#10'  begin'#10'    SendError(ARes, ''the id must be a number'', THTTPStatus'
  +'.BadRequest);'#10'    Exit;'#10'  end;'#10#10'  try'#10'    SendCustomer(AR'
  +'es, Service(AReq).Get(LId), THTTPStatus.OK);'#10'  except'#10'    on E: ECu'
  +'stomerNotFound do'#10'      SendError(ARes, E.Message, THTTPStatus.NotFound'
  +');'#10'  end;'#10'end;'#10#10'procedure AddCustomer(AReq: THorseRequest; AR'
  +'es: THorseResponse; ANext: TNextProc);'#10'begin'#10'  try'#10'    SendCust'
  +'omer(ARes, Service(AReq).Add(TCustomerInput.FromJSON(AReq.Body)), THTTPStat'
  +'us.Created);'#10'  except'#10'    on E: EPayloadError do'#10'      SendErro'
  +'r(ARes, E.Message, THTTPStatus.BadRequest);'#10'    on E: ECustomerInvalid '
  +'do'#10'      SendError(ARes, E.Message, THTTPStatus.UnprocessableEntity);'
  +#10'  end;'#10'end;'#10#10'procedure Registry;'#10'begin'#10'  THorse.Get('''
  +'/customers'', ListCustomers);'#10'  THorse.Get(''/customers/:id'', GetCusto'
  +'mer);'#10'  THorse.Post(''/customers'', AddCustomer);'#10'end;'#10#10'end.'
  +#10
]);
LazarusResources.Add('webcustomersservice','TXT',[
  '/// <summary> The business code of the customers feature. The routes resolve'
  +' the service from'#10'/// the request, and the service depends on the repos'
  +'itory contract, so a test creates it with'#10'/// a fake repository. Its me'
  +'thods are virtual, so a route test can replace it the same way.'#10'/// </s'
  +'ummary>'#10'unit Customers.Service;'#10#10'{$MODE DELPHI}{$H+}'#10#10'inter'
  +'face'#10#10'uses'#10'  SysUtils,'#10'  Repo.Customers,'#10'  Customers.Payl'
  +'oads;'#10#10'type'#10#10'  /// <summary> The customer does not exist. </sum'
  +'mary>'#10'  ECustomerNotFound = class(Exception);'#10#10'  /// <summary> Th'
  +'e input breaks a business rule. </summary>'#10'  ECustomerInvalid = class(E'
  +'xception);'#10#10'  TCustomerService = class'#10'  private'#10'    FReposit'
  +'ory: TCustomerRepository;'#10'  public'#10'    /// <summary> Creates the se'
  +'rvice, which owns and frees the repository. </summary>'#10'    constructor '
  +'Create(ARepository: TCustomerRepository);'#10'    destructor Destroy; overr'
  +'ide;'#10'    /// <summary> Returns every customer. </summary>'#10'    funct'
  +'ion List: TCustomerOutputs; virtual;'#10'    /// <summary> Returns the cust'
  +'omer with the id. Raises ECustomerNotFound. </summary>'#10'    function Get'
  +'(const AId: Integer): TCustomerOutput; virtual;'#10'    /// <summary> Valid'
  +'ates the input and creates the customer. Raises ECustomerInvalid.'#10'    /'
  +'// </summary>'#10'    function Add(const AInput: TCustomerInput): TCustomer'
  +'Output; virtual;'#10'  end;'#10#10'implementation'#10#10'uses'#10'  Repo.Mo'
  +'dels;'#10#10'constructor TCustomerService.Create(ARepository: TCustomerRepo'
  +'sitory);'#10'begin'#10'  inherited Create;'#10'  FRepository := ARepository'
  +';'#10'end;'#10#10'destructor TCustomerService.Destroy;'#10'begin'#10'  FRep'
  +'ository.Free;'#10'  inherited Destroy;'#10'end;'#10#10'function TCustomerSe'
  +'rvice.List: TCustomerOutputs;'#10'var'#10'  LCustomer: TCustomer;'#10'begin'
  +#10'  Result := [];'#10'  for LCustomer in FRepository.All do'#10'    Result'
  +' := Result + [TCustomerOutput.FromModel(LCustomer)];'#10'end;'#10#10'functi'
  +'on TCustomerService.Get(const AId: Integer): TCustomerOutput;'#10'var'#10' '
  +' LCustomer: TCustomer;'#10'begin'#10'  if not FRepository.Find(AId, LCustom'
  +'er) then'#10'    raise ECustomerNotFound.CreateFmt(''customer %d not found'
  +''', [AId]);'#10'  Result := TCustomerOutput.FromModel(LCustomer);'#10'end;'
  +#10#10'function TCustomerService.Add(const AInput: TCustomerInput): TCustome'
  +'rOutput;'#10'var'#10'  LCustomer: TCustomer;'#10'begin'#10'  if Trim(AInput'
  +'.Name) = '''' then'#10'    raise ECustomerInvalid.Create(''the name is requ'
  +'ired'');'#10'  if Pos(''@'', AInput.Email) < 2 then'#10'    raise ECustomer'
  +'Invalid.Create(''the email is not valid'');'#10'  if FRepository.FindByEmai'
  +'l(Trim(AInput.Email), LCustomer) then'#10'    raise ECustomerInvalid.Create'
  +'(''there is already a customer with this email'');'#10#10'  LCustomer.Id :='
  +' 0;'#10'  LCustomer.Name := Trim(AInput.Name);'#10'  LCustomer.Email := Tri'
  +'m(AInput.Email);'#10'  Result := TCustomerOutput.FromModel(FRepository.Inse'
  +'rt(LCustomer));'#10'end;'#10#10'end.'#10
]);
LazarusResources.Add('webhealthroutes','TXT',[
  '/// <summary> The health check route, for a load balancer or an orchestrator'
  +': 200 while the'#10'/// server takes requests, 503 once the graceful shutdo'
  +'wn started, so no new request is sent to'#10'/// it while the running ones '
  +'finish. </summary>'#10'unit Health.Routes;'#10#10'{$MODE DELPHI}{$H+}'#10#10
  +'interface'#10#10'  /// <summary> Registers GET /health in horse. </summary>'
  +#10'  procedure Registry;'#10#10'implementation'#10#10'uses'#10'  SysUtils,'
  +#10'  fpjson,'#10'  Horse,'#10'  Horse.Commons;'#10#10'procedure GetHealth(A'
  +'Req: THorseRequest; ARes: THorseResponse; ANext: TNextProc);'#10'var'#10'  '
  +'LJSON: TJSONObject;'#10'  LStatus: THTTPStatus;'#10'begin'#10'  if THorse.I'
  +'sShuttingDown then'#10'  begin'#10'    LJSON := TJSONObject.Create([''statu'
  +'s'', ''shutting down'']);'#10'    LStatus := THTTPStatus.ServiceUnavailable'
  +';'#10'  end'#10'  else'#10'  begin'#10'    LJSON := TJSONObject.Create([''s'
  +'tatus'', ''ok'', ''activeRequests'', THorse.ActiveRequests]);'#10'    LStat'
  +'us := THTTPStatus.OK;'#10'  end;'#10#10'  try'#10'    ARes.ContentType(''ap'
  +'plication/json'').Send(LJSON.AsJSON).Status(LStatus);'#10'  finally'#10'   '
  +' LJSON.Free;'#10'  end;'#10'end;'#10#10'procedure Registry;'#10'begin'#10' '
  +' THorse.Get(''/health'', GetHealth);'#10'end;'#10#10'end.'#10
]);
