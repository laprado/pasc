LazarusResources.Add('weblpr','TXT',[
  'program {APPNAME};'#10#10'{$MODE DELPHI}{$H+}'#10#10'uses'#10'  {$IFDEF UNIX'
  +'}'#10'  cthreads,'#10'  {$ENDIF}'#10'  SysUtils,'#10'  Horse,'#10'  Repo.Co'
  +'nfig,'#10'  Build,'#10'  Shutdown;'#10#10'const'#10'  DEFAULT_PORT = 9000;'
  +#10'  // how long the running requests have to finish once the shutdown star'
  +'ts'#10'  SHUTDOWN_TIMEOUT_MS = 5000;'#10#10'{$R *.res}'#10#10'function Port'
  +': Integer;'#10'begin'#10'  Result := StrToIntDef(GetEnvironmentVariable(''P'
  +'ORT''), DEFAULT_PORT);'#10'end;'#10#10'begin'#10'  Migrate;'#10'  Build.Con'
  +'figure;'#10#10'  // the HORSE_DAEMON define (project options) makes Listen '
  +'return, with the server running'#10'  // in its own thread, so the main thr'
  +'ead waits for the signal to stop it. The Debug mode has'#10'  // no range c'
  +'hecks: horse 3.3.14 fails every request when built with them (-Cr)'#10'  TH'
  +'orse.Listen(Port);'#10'  WriteLn(''{APPNAME} listening on http://localhost:'
  +''', THorse.Port, '', database '', DatabaseFile);'#10'  WriteLn(''Press Ctrl'
  +'+C to stop'');'#10#10'  WaitForShutdownSignal;'#10#10'  WriteLn(''Shutting '
  +'down, waiting up to '', SHUTDOWN_TIMEOUT_MS div 1000, ''s for the running r'
  +'equests'');'#10'  THorse.StopListenGraceful(SHUTDOWN_TIMEOUT_MS);'#10'  Wri'
  +'teLn(''{APPNAME} stopped'');'#10'end.'#10
]);
LazarusResources.Add('webrepoconfig','TXT',[
  '/// <summary> The repository access config: the SQLite database file, the co'
  +'nnections and the'#10'/// schema. </summary>'#10'unit Repo.Config;'#10#10'{'
  +'$MODE DELPHI}{$H+}'#10#10'interface'#10#10'uses'#10'  sqldb,'#10'  sqlite3c'
  +'onn;'#10#10'const'#10'  /// <summary> Environment variable with the databas'
  +'e file, used instead of the default.'#10'  /// </summary>'#10'  DATABASE_EN'
  +'V = ''DATABASE_FILE'';'#10#10'  /// <summary> Returns the database file: th'
  +'e value of DATABASE_FILE, or {APPNAME}.db next to'#10'  /// the executable.'
  +' </summary>'#10'  function DatabaseFile: string;'#10#10'  /// <summary> Ret'
  +'urns a new connection to the database, with its own transaction. Each reque'
  +'st'#10'  /// uses its own connection, so the requests running in parallel d'
  +'o not share one. The caller'#10'  /// frees it, which also frees the transa'
  +'ction. </summary>'#10'  function NewConnection: TSQLite3Connection;'#10#10
  +'  /// <summary> Creates the tables that do not exist yet. Called once, at t'
  +'he startup. </summary>'#10'  procedure Migrate;'#10#10'implementation'#10#10
  +'uses'#10'  SysUtils;'#10#10'function DatabaseFile: string;'#10'begin'#10'  '
  +'Result := GetEnvironmentVariable(DATABASE_ENV);'#10'  if Result = '''' then'
  +#10'    Result := ConcatPaths([ExtractFilePath(ParamStr(0)), ''{APPNAME}.db'
  +''']);'#10'end;'#10#10'function NewConnection: TSQLite3Connection;'#10'var'
  +#10'  LTransaction: TSQLTransaction;'#10'begin'#10'  Result := TSQLite3Conne'
  +'ction.Create(nil);'#10'  try'#10'    Result.DatabaseName := DatabaseFile;'
  +#10'    LTransaction := TSQLTransaction.Create(Result);'#10'    LTransaction'
  +'.DataBase := Result;'#10'    Result.Transaction := LTransaction;'#10'    Re'
  +'sult.Open;'#10'  except'#10'    Result.Free;'#10'    raise;'#10'  end;'#10
  +'end;'#10#10'procedure Migrate;'#10'var'#10'  LConnection: TSQLite3Connectio'
  +'n;'#10'begin'#10'  LConnection := NewConnection;'#10'  try'#10'    LConnect'
  +'ion.ExecuteDirect('#10'      ''create table if not exists customers ('' +'
  +#10'      ''  id integer primary key autoincrement,'' +'#10'      ''  name t'
  +'ext not null,'' +'#10'      ''  email text not null unique)'');'#10'    LCo'
  +'nnection.Transaction.Commit;'#10'  finally'#10'    LConnection.Free;'#10'  '
  +'end;'#10'end;'#10#10'end.'#10
]);
LazarusResources.Add('webrepocustomers','TXT',[
  '/// <summary> The customers repository. TCustomerRepository is the contract '
  +'the services depend'#10'/// on, TSQLiteCustomerRepository implements it wit'
  +'h SQLite. A test replaces it with a subclass'#10'/// that keeps the custome'
  +'rs in memory. </summary>'#10'unit Repo.Customers;'#10#10'{$MODE DELPHI}{$H+'
  +'}'#10#10'interface'#10#10'uses'#10'  sqlite3conn,'#10'  Repo.Models;'#10#10
  +'type'#10#10'  /// <summary> The customers repository contract: every method'
  +' is virtual and abstract, a'#10'  /// subclass implements them. </summary>'
  +#10'  TCustomerRepository = class'#10'  public'#10'    /// <summary> Returns'
  +' every customer, ordered by name. </summary>'#10'    function All: TCustome'
  +'rs; virtual; abstract;'#10'    /// <summary> Finds a customer by its id. Re'
  +'turns false if there is none. </summary>'#10'    function Find(const AId: I'
  +'nteger; out ACustomer: TCustomer): Boolean; virtual; abstract;'#10'    /// '
  +'<summary> Finds a customer by its email. Returns false if there is none. </'
  +'summary>'#10'    function FindByEmail(const AEmail: string; out ACustomer: '
  +'TCustomer): Boolean; virtual; abstract;'#10'    /// <summary> Inserts the c'
  +'ustomer and returns it with the new id. </summary>'#10'    function Insert('
  +'const ACustomer: TCustomer): TCustomer; virtual; abstract;'#10'  end;'#10#10
  +'  /// <summary> The customers repository on SQLite, with a connection of it'
  +'s own. </summary>'#10'  TSQLiteCustomerRepository = class(TCustomerReposito'
  +'ry)'#10'  private'#10'    FConnection: TSQLite3Connection;'#10'  public'#10
  +'    constructor Create;'#10'    destructor Destroy; override;'#10'    funct'
  +'ion All: TCustomers; override;'#10'    function Find(const AId: Integer; ou'
  +'t ACustomer: TCustomer): Boolean; override;'#10'    function FindByEmail(co'
  +'nst AEmail: string; out ACustomer: TCustomer): Boolean; override;'#10'    f'
  +'unction Insert(const ACustomer: TCustomer): TCustomer; override;'#10'  end;'
  +#10#10'implementation'#10#10'uses'#10'  SysUtils,'#10'  sqldb,'#10'  Repo.Co'
  +'nfig;'#10#10'function ReadCustomer(AQuery: TSQLQuery): TCustomer;'#10'begin'
  +#10'  Result.Id := AQuery.FieldByName(''id'').AsInteger;'#10'  Result.Name :'
  +'= AQuery.FieldByName(''name'').AsString;'#10'  Result.Email := AQuery.Field'
  +'ByName(''email'').AsString;'#10'end;'#10#10'constructor TSQLiteCustomerRepo'
  +'sitory.Create;'#10'begin'#10'  inherited Create;'#10'  FConnection := NewCo'
  +'nnection;'#10'end;'#10#10'destructor TSQLiteCustomerRepository.Destroy;'#10
  +'begin'#10'  FConnection.Free;'#10'  inherited Destroy;'#10'end;'#10#10'func'
  +'tion TSQLiteCustomerRepository.All: TCustomers;'#10'var'#10'  LQuery: TSQLQ'
  +'uery;'#10'begin'#10'  Result := [];'#10'  LQuery := TSQLQuery.Create(nil);'
  +#10'  try'#10'    LQuery.DataBase := FConnection;'#10'    LQuery.SQL.Text :='
  +' ''select id, name, email from customers order by name'';'#10'    LQuery.Op'
  +'en;'#10'    while not LQuery.EOF do'#10'    begin'#10'      Result := Resul'
  +'t + [ReadCustomer(LQuery)];'#10'      LQuery.Next;'#10'    end;'#10'  final'
  +'ly'#10'    LQuery.Free;'#10'  end;'#10'end;'#10#10'function TSQLiteCustomer'
  +'Repository.Find(const AId: Integer; out ACustomer: TCustomer): Boolean;'#10
  +'var'#10'  LQuery: TSQLQuery;'#10'begin'#10'  ACustomer := Default(TCustomer'
  +');'#10'  LQuery := TSQLQuery.Create(nil);'#10'  try'#10'    LQuery.DataBase'
  +' := FConnection;'#10'    LQuery.SQL.Text := ''select id, name, email from c'
  +'ustomers where id = :id'';'#10'    LQuery.ParamByName(''id'').AsInteger := '
  +'AId;'#10'    LQuery.Open;'#10'    Result := not LQuery.EOF;'#10'    if Resu'
  +'lt then'#10'      ACustomer := ReadCustomer(LQuery);'#10'  finally'#10'    '
  +'LQuery.Free;'#10'  end;'#10'end;'#10#10'function TSQLiteCustomerRepository.'
  +'FindByEmail(const AEmail: string; out ACustomer: TCustomer): Boolean;'#10'v'
  +'ar'#10'  LQuery: TSQLQuery;'#10'begin'#10'  ACustomer := Default(TCustomer)'
  +';'#10'  LQuery := TSQLQuery.Create(nil);'#10'  try'#10'    LQuery.DataBase '
  +':= FConnection;'#10'    LQuery.SQL.Text := ''select id, name, email from cu'
  +'stomers where email = :email'';'#10'    LQuery.ParamByName(''email'').AsStr'
  +'ing := AEmail;'#10'    LQuery.Open;'#10'    Result := not LQuery.EOF;'#10' '
  +'   if Result then'#10'      ACustomer := ReadCustomer(LQuery);'#10'  finall'
  +'y'#10'    LQuery.Free;'#10'  end;'#10'end;'#10#10'function TSQLiteCustomerR'
  +'epository.Insert(const ACustomer: TCustomer): TCustomer;'#10'var'#10'  LQue'
  +'ry: TSQLQuery;'#10'begin'#10'  LQuery := TSQLQuery.Create(nil);'#10'  try'
  +#10'    LQuery.DataBase := FConnection;'#10'    LQuery.SQL.Text := ''insert '
  +'into customers (name, email) values (:name, :email)'';'#10'    LQuery.Param'
  +'ByName(''name'').AsString := ACustomer.Name;'#10'    LQuery.ParamByName(''e'
  +'mail'').AsString := ACustomer.Email;'#10'    LQuery.ExecSQL;'#10'    Result'
  +' := ACustomer;'#10'    Result.Id := FConnection.GetInsertID;'#10'    FConne'
  +'ction.Transaction.Commit;'#10'  finally'#10'    LQuery.Free;'#10'  end;'#10
  ,'end;'#10#10'end.'#10
]);
