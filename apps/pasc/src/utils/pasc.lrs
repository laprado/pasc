  +'  Customers.Routes,'#10'  Health.Routes;'#10#10'function NewCustomerService'
  +': TObject;'#10'begin'#10'  Result := TCustomerService.Create(TSQLiteCustome'
  +'rRepository.Create);'#10'end;'#10#10'procedure Services(AReq: THorseRequest'
  +'; ARes: THorseResponse; ANext: TNextProc);'#10'begin'#10'  AReq.Services.Ad'
  +'dFactory(TCustomerService, NewCustomerService);'#10'  ANext();'#10'end;'#10
  +#10'procedure Configure;'#10'begin'#10'  THorse.Use(Services);'#10#10'  Heal'
