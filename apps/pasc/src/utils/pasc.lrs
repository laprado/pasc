  +'rUtils;'#10#10'procedure TTestCustomersPayloads.TestInputFromJSON;'#10'var'
  +#10'  LInput: TCustomerInput;'#10'begin'#10'  LInput := TCustomerInput.FromJ'
  +'SON(''{"name": "Ana", "email": "ana@example.com"}'');'#10'  AssertEquals('''
  +'Ana'', LInput.Name);'#10'  AssertEquals(''ana@example.com'', LInput.Email);'
  +#10'end;'#10#10'procedure TTestCustomersPayloads.TestInputFromInvalidJSON;'
  +#10'begin'#10'  try'#10'    TCustomerInput.FromJSON(''not json'');'#10'    F'
  +'ail(''an invalid body should raise an exception'');'#10'  except'#10'    on'
  +' E: EPayloadError do'#10'      AssertTrue(ContainsStr(E.Message, ''not a va'
  +'lid JSON''));'#10'  end;'#10'end;'#10#10'procedure TTestCustomersPayloads.T'
  +'estInputFromJSONArray;'#10'begin'#10'  try'#10'    TCustomerInput.FromJSON('
