  'unit TestCommandCount;'#10#10'{$MODE DELPHI}{$H+}'#10#10'interface'#10#10'us'
  +'es'#10'  SysUtils,'#10'  fpcunit,'#10'  testregistry,'#10'  Command.Interfa'
  +'ces,'#10'  Command.Builder;'#10#10'type'#10#10'  TTestCommandCount = class('
  +'TTestCase)'#10'  private'#10'    FBuilder: ICommandBuilder;'#10'    procedu'
  +'re RunCount(const AArgs: TArray<string>);'#10'  protected'#10'    procedure'
  +' SetUp; override;'#10'    procedure TearDown; override;'#10'  published'#10
  +'    procedure TestCountTo;'#10'    procedure TestCountToOutOfRange;'#10'   '
  +' procedure TestCountCommandDefault;'#10'    procedure TestCountCommandWithV'
  +'alue;'#10'    procedure TestCountCommandInvalidValue;'#10'  end;'#10#10'imp'
  +'lementation'#10#10'uses'#10'  StrUtils,'#10'  Command.Count,'#10'  TestOutp'
  +'ut;'#10#10'procedure TTestCommandCount.SetUp;'#10'begin'#10'  FBuilder := T'
  +'CommandBuilder.Create(ExtractFileName(ParamStr(0)));'#10'  CaptureOutput(FB'
  +'uilder);'#10'  Command.Count.Registry(FBuilder);'#10'  ExitCode := 0;'#10'e'
  +'nd;'#10#10'procedure TTestCommandCount.TearDown;'#10'begin'#10'  // the com'
  +'mand sets the exit code on errors, the test runner should not exit with it'
  +#10'  ExitCode := 0;'#10'end;'#10#10'procedure TTestCommandCount.RunCount(co'
  +'nst AArgs: TArray<string>);'#10'begin'#10'  FBuilder.UseArguments(AArgs);'
  +#10'  FBuilder.Parse;'#10'  FBuilder.Execute;'#10'end;'#10#10'procedure TTes'
  +'tCommandCount.TestCountTo;'#10'var'#10'  LNumbers: TArray<Integer>;'#10'beg'
  +'in'#10'  LNumbers := CountTo(3);'#10'  AssertEquals(3, Length(LNumbers));'
  +#10'  AssertEquals(1, LNumbers[0]);'#10'  AssertEquals(3, LNumbers[2]);'#10
  +'end;'#10#10'procedure TTestCommandCount.TestCountToOutOfRange;'#10'begin'#10
  +'  try'#10'    CountTo(0);'#10'    Fail(''zero should be out of range'');'#10
  +'  except'#10'    on E: EArgumentOutOfRangeException do'#10'      AssertTrue'
  +'(ContainsStr(E.Message, ''between 1 and''));'#10'  end;'#10'end;'#10#10'pro'
  +'cedure TTestCommandCount.TestCountCommandDefault;'#10'begin'#10'  RunCount('
  +'[''count'']);'#10'  AssertEquals(''1'' + LineEnding + ''2'' + LineEnding + '
  +'''3'' + LineEnding, OutputCaptured);'#10'end;'#10#10'procedure TTestCommand'
  +'Count.TestCountCommandWithValue;'#10'begin'#10'  RunCount([''count'', ''--t'
  +'o=5'']);'#10'  AssertTrue(''should count up to 5. Check: '' + OutputCapture'
  +'d, ContainsStr(OutputCaptured, ''5'' + LineEnding));'#10'  AssertEquals(0, '
  +'ExitCode);'#10'end;'#10#10'procedure TTestCommandCount.TestCountCommandInva'
  +'lidValue;'#10'begin'#10'  RunCount([''count'', ''--to=x'']);'#10'  AssertTr'
  +'ue(''should explain the error. Check: '' + OutputCaptured, ContainsStr(Outp'
  +'utCaptured, ''must be a number''));'#10'  AssertEquals(1, ExitCode);'#10'en'
  +'d;'#10#10'initialization'#10'  RegisterTest(TTestCommandCount);'#10#10'end.'
  +#10
]);
