LazarusResources.Add('webshutdown','TXT',[
  '/// <summary> Waits for the signal to stop the app: SIGINT (Ctrl+C) or SIGTE'
  +'RM, sent by a'#10'/// service manager or a container runtime, on Linux and '
  +'macOS; Ctrl+C, Ctrl+Break or the'#10'/// console being closed on Windows. <'
  +'/summary>'#10'unit Shutdown;'#10#10'{$MODE DELPHI}{$H+}'#10#10'interface'#10
  +#10'  /// <summary> Installs the signal handlers and blocks until one of the'
  +' signals arrives.'#10'  /// </summary>'#10'  procedure WaitForShutdownSigna'
  +'l;'#10#10'implementation'#10#10'uses'#10'  {$IF DEFINED(UNIX)}'#10'  BaseUn'
  +'ix,'#10'  {$ELSEIF DEFINED(WINDOWS)}'#10'  Windows,'#10'  {$ENDIF}'#10'  Sy'
  +'sUtils;'#10#10'var'#10'  ShutdownRequested: Boolean = False;'#10#10'{$IF DE'
  +'FINED(UNIX)}'#10'procedure SignalHandler(ASignal: cint); cdecl;'#10'begin'
  +#10'  // only sets the flag, the shutdown runs in the main thread'#10'  Shut'
  +'downRequested := True;'#10'end;'#10#10'procedure InstallHandlers;'#10'begin'
  +#10'  fpSignal(SIGINT, SignalHandler);'#10'  fpSignal(SIGTERM, SignalHandler'
  +');'#10'end;'#10'{$ELSEIF DEFINED(WINDOWS)}'#10'function ConsoleHandler(ACtr'
  +'lType: DWORD): BOOL; stdcall;'#10'begin'#10'  ShutdownRequested := True;'#10
  +'  Result := True;'#10'end;'#10#10'procedure InstallHandlers;'#10'begin'#10
  +'  SetConsoleCtrlHandler(@ConsoleHandler, True);'#10'end;'#10'{$ENDIF}'#10#10
  +'procedure WaitForShutdownSignal;'#10'begin'#10'  InstallHandlers;'#10'  whi'
  +'le not ShutdownRequested do'#10'    Sleep(100);'#10'end;'#10#10'end.'#10
]);
