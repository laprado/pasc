  +'ion'');'#10'  except'#10'    on E: EPayloadError do'#10'      AssertEquals('
  +'''the body must be a JSON object'', E.Message);'#10'  end;'#10'end;'#10#10
  +'procedure TTestCustomersPayloads.TestOutputsToJSON;'#10'var'#10'  LCustomer'
