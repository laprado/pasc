LazarusResources.Add('clicommandcount','TXT',[
  '/// <summary> Example of a command with an option that requires a value: cou'
  +'nts up to a number.'#10'/// </summary>'#10'unit Command.Count;'#10#10'{$MOD'
  +'E DELPHI}{$H+}'#10#10'interface'#10#10'uses'#10'  Command.Interfaces;'#10#10
  +'  /// <summary> Returns the numbers from 1 to ATo. The business code stays '
  +'out of the command,'#10'  /// so it is tested without the builder. </summar'
  +'y>'#10'  function CountTo(const ATo: Integer): TArray<Integer>;'#10#10'  //'
  +'/ <summary> Shows the numbers from 1 to the value of --to, 3 by default. </'
  +'summary>'#10'  procedure CountCommand(ABuilder: ICommandBuilder);'#10#10'  '
  +'/// <summary> Registry the count command and its options in the command bui'
  +'lder. </summary>'#10'  procedure Registry(ABuilder: ICommandBuilder);'#10#10
  +'implementation'#10#10'uses'#10'  SysUtils;'#10#10'const'#10'  DEFAULT_COUNT'
  +' = 3;'#10'  MAX_COUNT = 100;'#10#10'function CountTo(const ATo: Integer): T'
  +'Array<Integer>;'#10'var'#10'  I: Integer;'#10'begin'#10'  if (ATo < 1) or ('
  +'ATo > MAX_COUNT) then'#10'    raise EArgumentOutOfRangeException.CreateFmt('
  +'''the count must be between 1 and %d'', [MAX_COUNT]);'#10#10'  SetLength(Re'
  +'sult, ATo);'#10'  for I := 1 to ATo do'#10'    Result[I - 1] := I;'#10'end;'
  +#10#10'procedure CountCommand(ABuilder: ICommandBuilder);'#10'var'#10'  LVal'
  +'ue: string;'#10'  LTo, LNumber: Integer;'#10'begin'#10'  LTo := DEFAULT_COU'
  +'NT;'#10'  if ABuilder.CheckOption(''to'', LValue) and not TryStrToInt(LValu'
  +'e, LTo) then'#10'  begin'#10'    ABuilder.OutputColor(''the value of --to m'
  +'ust be a number'' + LineEnding, ABuilder.ColorTheme.Error);'#10'    ExitCod'
  +'e := 1;'#10'    Exit;'#10'  end;'#10#10'  try'#10'    for LNumber in CountT'
  +'o(LTo) do'#10'      ABuilder.OutputColor(IntToStr(LNumber) + LineEnding, AB'
  +'uilder.ColorTheme.Value);'#10'  except'#10'    on E: EArgumentOutOfRangeExc'
  +'eption do'#10'    begin'#10'      ABuilder.OutputColor(E.Message + LineEndi'
  +'ng, ABuilder.ColorTheme.Error);'#10'      ExitCode := 1;'#10'    end;'#10' '
  +' end;'#10'end;'#10#10'procedure Registry(ABuilder: ICommandBuilder);'#10'be'
  +'gin'#10'  ABuilder'#10'    .AddCommand('#10'      ''count'','#10'      ''Co'
  +'unts from 1 up to a number.''#13#10 +'#10'      ''Ex: '' + ABuilder.ExeName'
  +' + '' count''#13#10 +'#10'      ''Ex: '' + ABuilder.ExeName + '' count --to'
  +'=5'','#10'      @CountCommand,'#10'      [ccNoParameters])'#10'      .AddOp'
  +'tion(''t'', ''to'', ''the last number, from 1 to 100. Default: 3.'', [], oc'
  +'RequiresValue);'#10'end;'#10#10'end.'#10
]);
LazarusResources.Add('clicommandgreet','TXT',[
  '/// <summary> Example of a command with an argument and an option: greets th'
  +'e given name.'#10'/// </summary>'#10'unit Command.Greet;'#10#10'{$MODE DELP'
  +'HI}{$H+}'#10#10'interface'#10#10'uses'#10'  Command.Interfaces;'#10#10'  //'
  +'/ <summary> Returns the greeting for the given name, in upper case when ASh'
  +'out is true.'#10'  /// The business code stays out of the command, so it is'
  +' tested without the builder.'#10'  /// </summary>'#10'  function GreetMessa'
  +'ge(const AName: string; const AShout: Boolean): string;'#10#10'  /// <summa'
  +'ry> Greets the name given as argument. With --shout the greeting is in uppe'
  +'r case.'#10'  /// </summary>'#10'  procedure GreetCommand(ABuilder: IComman'
  +'dBuilder);'#10#10'  /// <summary> Registry the greet command and its option'
  +'s in the command builder. </summary>'#10'  procedure Registry(ABuilder: ICo'
  +'mmandBuilder);'#10#10'implementation'#10#10'uses'#10'  SysUtils;'#10#10'fun'
  +'ction GreetMessage(const AName: string; const AShout: Boolean): string;'#10
  +'begin'#10'  if Trim(AName) = '''' then'#10'    raise EArgumentException.Cre'
  +'ate(''a name is required'');'#10#10'  Result := ''Hello, '' + Trim(AName) +'
  +' ''!'';'#10'  if AShout then'#10'    Result := UpperCase(Result);'#10'end;'
  +#10#10'procedure GreetCommand(ABuilder: ICommandBuilder);'#10'begin'#10'  AB'
  +'uilder.OutputColor('#10'    GreetMessage(ABuilder.GetParsedArguments[0].Val'
  +'ue, ABuilder.CheckOption(''shout'')) + LineEnding,'#10'    ABuilder.ColorTh'
  +'eme.Value);'#10'end;'#10#10'procedure Registry(ABuilder: ICommandBuilder);'
  +#10'begin'#10'  ABuilder'#10'    .AddCommand('#10'      ''greet'','#10'     '
  +' ''Greets the given name.''#13#10 +'#10'      ''Ex: '' + ABuilder.ExeName +'
  +' '' greet World''#13#10 +'#10'      ''Ex: '' + ABuilder.ExeName + '' greet '
  +'World --shout'','#10'      @GreetCommand,'#10'      [ccRequiresOneArgument]'
